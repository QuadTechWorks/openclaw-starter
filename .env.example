# =============================================================================
# .env — OpenClaw Local Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored — never commit it.
# =============================================================================

# ── LLM API Keys ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_WITH_YOUR_KEY
OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_KEY        # optional — for embeddings / fallback

# ── Web Search (optional — enables tavily-search skill) ───────────────────────
TAVILY_API_KEY=tvly-REPLACE_WITH_YOUR_KEY

# ── Gateway Auth Token ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
GATEWAY_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_HEX

# ── Ports (change only if defaults clash with something else) ─────────────────
OPENCLAW_GATEWAY_HOST_PORT=18789
OPENCLAW_TEAMS_PORT=3978
OPENCLAW_WATCHER_PORT=18791

# ── UID / GID — run containers as your host user (avoids permission issues) ───
# setup.sh fills these in automatically. For manual setup, run:  id -u  /  id -g
OPENCLAW_UID=1000
OPENCLAW_GID=1000

# ── Microsoft Teams (only needed with docker-compose.teams.yml) ───────────────
# TEAMS_APP_ID=REPLACE_WITH_TEAMS_BOT_APP_ID
# TEAMS_APP_PASSWORD=REPLACE_WITH_TEAMS_BOT_APP_SECRET
# TEAMS_TENANT_ID=REPLACE_WITH_AZURE_TENANT_ID

# ── Telegram (only needed with docker-compose.telegram.yml) ───────────────────
# Get a bot token from @BotFather on Telegram:
#   1. Open Telegram, search @BotFather
#   2. Send /newbot, follow prompts
#   3. Copy the token (format: 123456789:ABCdef...)
# TELEGRAM_BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN

# ── ngrok (used for Teams webhook AND/OR WhatsApp pairing) ────────────────────
# Sign up at dashboard.ngrok.com (free), then:
#   - Authtoken: dashboard.ngrok.com → Your Authtoken
#   - Static URL: dashboard.ngrok.com → Domains → Create static domain
# NGROK_AUTHTOKEN=REPLACE_WITH_NGROK_AUTHTOKEN
# NGROK_URL=https://REPLACE_WITH_YOUR_STATIC_DOMAIN.ngrok-free.app
