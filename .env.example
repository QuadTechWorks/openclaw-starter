# =============================================================================
# .env — OpenClaw Local Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is gitignored — never commit it.
# =============================================================================

# ── LLM API Keys ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_WITH_YOUR_KEY
OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_KEY        # optional — for embeddings / fallback

# ── Web Search (optional — enables tavily-search skill) ───────────────────────
TAVILY_API_KEY=tvly-REPLACE_WITH_YOUR_KEY

# ── Gateway Auth Token ────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
GATEWAY_TOKEN=REPLACE_WITH_RANDOM_32_BYTE_HEX

# ── Ports (change only if defaults clash with something else) ─────────────────
OPENCLAW_GATEWAY_HOST_PORT=18789
OPENCLAW_TEAMS_PORT=3978
OPENCLAW_WATCHER_PORT=18791

# ── Teams (only needed if using docker-compose.teams.yml) ─────────────────────
# TEAMS_APP_ID=REPLACE_WITH_TEAMS_BOT_APP_ID
# TEAMS_APP_PASSWORD=REPLACE_WITH_TEAMS_BOT_APP_SECRET
# TEAMS_TENANT_ID=REPLACE_WITH_AZURE_TENANT_ID

# ── Ngrok (only needed if using docker-compose.teams.yml) ─────────────────────
# NGROK_AUTHTOKEN=REPLACE_WITH_NGROK_AUTHTOKEN
# NGROK_URL=https://REPLACE_WITH_YOUR_STATIC_DOMAIN.ngrok-free.app
